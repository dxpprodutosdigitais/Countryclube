# Caddy (recomendado para VPS): HTTPS automático via Let's Encrypt.
# Instale o Caddy, copie este arquivo para /etc/caddy/Caddyfile e envie o conteúdo de `out/` para /var/www/countryclube.
countryclube.dxp.dev.br {
	root * /var/www/countryclube
	encode gzip zstd
	file_server

	# Rotas do Next.js exportado terminam em "/" (trailingSlash) — redireciona /agenda → /agenda/.
	@dir {
		not path /_next/* /images/* /*.png /*.svg /*.ico /*.txt /*.xml
		not path_regexp \.[a-zA-Z0-9]+$
		not path */
		file {path}/index.html
	}
	redir @dir {path}/ 308

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
	header /images/* Cache-Control "public, max-age=604800"
}
